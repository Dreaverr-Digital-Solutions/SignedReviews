{
  // Cloudflare Pages config for signedreviews.com landing.
  //
  // Static assets are built into ./dist by build.js. The functions directory
  // provides serverless onRequest handlers (markdown negotiation, agent-ready
  // test endpoint).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signedreviews-landing",
  "compatibility_date": "2026-05-04",
  "pages_build_output_dir": "./dist"
}
