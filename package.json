{
  "name": "signedreviewslandingpage",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for Signed Reviews (signedreviews.com) — operated by Paid Rightly LLC.",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css --minify",
    "build": "npm run build:css && node build.js && node build-og-images.js",
    "dev": "node dev-server.js",
    "dev:host": "node dev-server.js --host",
    "test": "playwright test",
    "test:ios": "playwright test --project=webkit-ios",
    "test:ios:headed": "playwright test --project=webkit-ios --headed",
    "notify-deploy": "node notify-deploy.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dreaverr-Digital-Solutions/SignedReviews.git"
  },
  "license": "ISC",
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2"
  }
}
